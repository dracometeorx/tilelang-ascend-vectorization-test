                simtvf_tz = T.launch_thread("threadIdx.z", 1)
                T.attr("simtvf", "tl.simtvf_scope", 1)
                o[simtvf_tx * 2 + 512:simtvf_tx * 2 + 512 + 2] = a[simtvf_tx * 2:simtvf_tx * 2 + 2] + b[simtvf_tx * 2 + 256:simtvf_tx * 2 + 256 + 2]
            T.ascend_set_flag("V_MTE3", 0)
            T.ascend_wait_flag("V_MTE3", 0)
            T.ascend_copy_ubuf_to_gm(T.tvm_access_ptr(T.type_annotation("float32"), O, 0, 256, 2), T.tvm_access_ptr(T.type_annotation("float32"), buf_dyn_shmem.data, 512, 256, 1), 0, 1, 1024, 4, 1024, 1024)