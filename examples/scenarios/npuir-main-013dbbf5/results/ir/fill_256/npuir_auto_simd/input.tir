# from tvm.script import tir as T

@T.prim_func
def main(A: T.Buffer((256,), "float32"), B: T.Buffer((1,), "float32"), O: T.Buffer((256,), "float32")):
    # with T.block("root"):
    cid = T.launch_thread("blockIdx.x", 1)
    vid = T.launch_thread("blockIdx.z", 2)
    with T.block("tilelang_root"):
        T.reads(O[0])
        T.writes()
        T.block_attr({"tilelang.is_npu_kernel_frame": T.bool(True)})
        a = T.alloc_buffer((256,), scope="shared.dyn")
        b = T.alloc_buffer((1,), scope="shared.dyn")
        o = T.alloc_buffer((256,), scope="shared.dyn")
        for i in T.parallel(256):
            o[i] = T.float32(1.25)
        T.copy(T.region(o[0], 1, 256), T.region(O[0], 2, 256))