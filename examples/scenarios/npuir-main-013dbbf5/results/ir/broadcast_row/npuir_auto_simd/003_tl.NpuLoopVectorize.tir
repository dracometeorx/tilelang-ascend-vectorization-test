# from tvm.script import ir as I
# from tvm.script import tir as T

@I.ir_module
class Module:
    @T.prim_func
    def main(A: T.Buffer((4, 64), "float32"), B: T.Buffer((64,), "float32"), O: T.Buffer((4, 64), "float32")):
        T.func_attr({"target": T.target({"host": {"keys": ["cpu"], "kind": "stackvm", "tag": ""}, "keys": [], "kind": "npuir", "tag": ""})})
        # with T.block("root"):
        cid = T.launch_thread("blockIdx.x", 1)
        vid = T.launch_thread("blockIdx.z", 2)
        with T.block("tilelang_root"):
            T.reads(A[0, 0], B[0], O[0, 0])
            T.writes()
            a = T.alloc_buffer((4, 64), scope="shared.dyn")
            b = T.alloc_buffer((64,), scope="shared.dyn")
            o = T.alloc_buffer((4, 64), scope="shared.dyn")
            local_src_buf = T.alloc_buffer((64,), scope="shared.dyn")
            reshape_view_buf = T.alloc_buffer((1, 64), scope="shared.dyn")
            brc_buf = T.alloc_buffer((4, 64), scope="shared.dyn")
            T.copy(T.region(A[0, 0], 1, 4, 64), T.region(a[0, 0], 2, 4, 64))
            T.copy(T.region(B[0], 1, 64), T.region(b[0], 2, 64))
            T.copy(T.region(b[0], 1, 64), T.region(local_src_buf[0], 2, 64))
            T.npuir_reshape(T.region(local_src_buf[0], 1, 64), T.region(reshape_view_buf[0, 0], 2, 1, 64))
            T.npuir_brc(T.region(reshape_view_buf[0, 0], 1, 1, 64), T.region(brc_buf[0, 0], 2, 4, 64))
            T.npuir_add(T.region(a[0, 0], 1, 4, 64), T.region(brc_buf[0, 0], 1, 4, 64), T.region(o[0, 0], 2, 4, 64))
            T.copy(T.region(o[0, 0], 1, 4, 64), T.region(O[0, 0], 2, 4, 64))