# from tvm.script import tirx as T

@T.prim_func
def main(A_handle: T.handle, B_handle: T.handle, O_handle: T.handle):
    A = T.match_buffer(A_handle, (4, 64), strides=(64, 1))
    B = T.match_buffer(B_handle, (4, 1), strides=(1, 1))
    O = T.match_buffer(O_handle, (4, 64), strides=(64, 1))
    # with T.sblock("root"):
    for bx in T.thread_binding(1, thread="blockIdx.x"):
        tx: T.int32 = T.launch_thread_idx(0)
        ty: T.int32 = T.launch_thread_idx(1)
        tz: T.int32 = T.launch_thread_idx(2)
        with T.sblock("tilelang_root"):
            T.reads()
            T.writes()
            a = T.sblock_alloc_buffer((4, 64), scope="shared.dyn")
            b = T.sblock_alloc_buffer((4, 1), scope="shared.dyn")
            o = T.sblock_alloc_buffer((4, 64), scope="shared.dyn")
            T.ascend_copy(T.region(A[0, 0], 1, 4, 64), T.region(a[0, 0], 2, 4, 64))
            T.ascend_copy(T.region(B[0, 0], 1, 4, 1), T.region(b[0, 0], 2, 4, 1))
            with T.sblock("SIMT_VF", no_realize=True):
                T.reads()
                T.writes()
                T.sblock_attr({"tl.vf_source_index": T.int64(0)})
                simtvf_tx = T.launch_thread("threadIdx.x", 128)
                simtvf_ty = T.launch_thread("threadIdx.y", 1)
                simtvf_tz = T.launch_thread("threadIdx.z", 1)
                T.attr("simtvf", "tl.simtvf_scope", 1)
                for i in T.parallel(4):
                    for j in T.parallel(64):
                        o[i, j] = a[i, j] + b[i, 0]
            T.ascend_copy(T.region(o[0, 0], 1, 4, 64), T.region(O[0, 0], 2, 4, 64))