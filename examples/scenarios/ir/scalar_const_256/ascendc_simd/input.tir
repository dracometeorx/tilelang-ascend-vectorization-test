# from tvm.script import tirx as T

@T.prim_func
def main(A_handle: T.handle, B_handle: T.handle, O_handle: T.handle):
    A = T.match_buffer(A_handle, (256,), strides=(1,))
    B = T.match_buffer(B_handle, (1,), strides=(1,))
    O = T.match_buffer(O_handle, (256,), strides=(1,))
    # with T.sblock("root"):
    for bx in T.thread_binding(1, thread="blockIdx.x"):
        tx: T.int32 = T.launch_thread_idx(0)
        ty: T.int32 = T.launch_thread_idx(1)
        tz: T.int32 = T.launch_thread_idx(2)
        with T.sblock("tilelang_root"):
            T.reads()
            T.writes()
            a = T.sblock_alloc_buffer((256,), scope="shared.dyn")
            b = T.sblock_alloc_buffer((1,), scope="shared.dyn")
            o = T.sblock_alloc_buffer((256,), scope="shared.dyn")
            T.ascend_copy(T.region(A[0], 1, 256), T.region(a[0], 2, 256))
            with T.sblock("SIMD_VF", no_realize=True):
                T.reads()
                T.writes()
                T.sblock_attr({"tl.vf_source_index": T.int64(0)})
                T.attr("simdvf", "tl.simdvf_scope", 1)
                for i in T.parallel(256):
                    o[i] = a[i] + T.float32(1.25)
            T.ascend_copy(T.region(o[0], 1, 256), T.region(O[0], 2, 256))